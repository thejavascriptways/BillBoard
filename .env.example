# Local Postgres from docker compose. The two URLs can be the same on your machine.
# On Supabase, they are different. See the commented examples under each name.
DATABASE_URL="postgresql://billboard:billboard@127.0.0.1:5432/billboard"
DIRECT_URL="postgresql://billboard:billboard@127.0.0.1:5432/billboard"

# Supabase free tier, from the dashboard Connect dialog. Billboard talks to
# Postgres through Prisma only. Do not set a Supabase URL key, anon key, or
# service role key, and do not turn on Supabase Auth.
#
# DATABASE_URL is the shared pooler in transaction mode (port 6543). The app
# uses this at runtime. pgbouncer=true turns off prepared statements, which
# transaction mode cannot keep. connection_limit=1 keeps each serverless
# instance from opening its own pool in front of Supavisor.
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require
#
# DIRECT_URL is what `prisma migrate deploy` uses. Use the shared pooler in
# session mode (port 5432 on the same pooler host). That host is IPv4, so a
# Vercel build can reach it. The direct host db.[PROJECT-REF].supabase.co:5432
# is IPv6-only on the free plan, so leave it for a machine that has IPv6.
# Do not add pgbouncer=true on DIRECT_URL. Migrations need a real session.
# postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require
#
# URL-encode special characters in the database password before you paste it
# into either URL. @ becomes %40, # becomes %23, % becomes %25, and / becomes %2F.
# The packaged Mac app asks for these on first launch and stores them in the
# Keychain. `npm run desktop:dev` still reads this file.

# openssl rand -hex 32. Signs the shared session cookie. Not a Supabase secret.
AUTH_SECRET="replace-with-a-long-random-string"

# One password for the whole family. No accounts, no roles, no public sign-up.
APP_PASSWORD="change-me"
