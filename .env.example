# Local Postgres from docker compose, or any Postgres 16 database.
DATABASE_URL="postgresql://billboard:billboard@127.0.0.1:5432/billboard"
# Neon: use the pooled URL above and the direct (non-pooler) URL here.
# Locally they can be the same.
DIRECT_URL="postgresql://billboard:billboard@127.0.0.1:5432/billboard"

# openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# The single password for Billboard. There is no public sign-up.
APP_PASSWORD="change-me"
