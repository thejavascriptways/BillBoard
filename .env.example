# Signs the shared session cookie. openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-string"

# One password for the whole family in the browser. No accounts and no roles.
# The Mac app uses a separate lock password.
APP_PASSWORD="change-me"

# Used only by `npm run migrate:supabase-to-sheet` and Settings → Copy from Supabase.
# The running app does not need Postgres.
# DATABASE_URL="postgresql://billboard:billboard@127.0.0.1:5432/billboard"
# DIRECT_URL="postgresql://billboard:billboard@127.0.0.1:5432/billboard"
