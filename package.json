{
  "name": "billboard",
  "version": "0.1.0",
  "private": true,
  "main": "electron-dist/main.js",
  "allowScripts": {
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true,
    "fsevents": true,
    "prisma": true,
    "unrs-resolver": true,
    "electron": true,
    "electron-builder": true,
    "@electron/get": true,
    "app-builder-bin": true
  },
  "scripts": {
    "dev": "next dev -p 3847 -H 0.0.0.0",
    "build": "prisma generate && prisma migrate deploy && next build",
    "start": "next start -p 3847 -H 0.0.0.0",
    "lint": "eslint",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "db:clear-samples": "tsx --env-file=.env prisma/clear-samples.ts",
    "desktop:dev": "tsc -p tsconfig.electron.json && electron .",
    "desktop:build": "node scripts/desktop-build.mjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx --env-file=.env prisma/seed.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@prisma/client": "^6.19.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "prisma": "^6.19.3",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.8",
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "com.deepaksingla.billboard",
    "productName": "BillBoard",
    "executableName": "billboard",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron-dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "electron/static",
        "to": "electron-static"
      },
      {
        "from": ".next/standalone",
        "to": "standalone"
      },
      {
        "from": ".next/static",
        "to": "standalone/.next/static"
      },
      {
        "from": "public",
        "to": "standalone/public"
      },
      {
        "from": "build/tray.png",
        "to": "tray.png"
      }
    ],
    "mac": {
      "category": "public.app-category.finance",
      "icon": "build/icon.icns",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "target": [
        {
          "target": "dmg",
          "arch": ["arm64"]
        },
        {
          "target": "dir",
          "arch": ["arm64"]
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "Office",
      "target": [
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    }
  }
}
