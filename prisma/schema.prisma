generator client {
  provider = "prisma-client-js"
}

/// Runtime queries use DATABASE_URL (Supabase transaction pooler).
/// Migrations use DIRECT_URL (Supabase session pooler, or a direct IPv6 URL).
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// The household ledger. Everyone signs in with the same APP_PASSWORD.
/// There are no user accounts and no roles.
model Household {
  id               String            @id @default(cuid())
  name             String
  timezone         String            @default("America/Chicago")
  currency         String            @default("USD")
  createdAt        DateTime          @default(now())
  properties       Property[]
  categories       Category[]
  paymentMethods   PaymentMethod[]
  expenses         Expense[]
  people           Person[]
  vehicles         Vehicle[]
  occupancyPeriods OccupancyPeriod[]
  payerSplits        PayerSplit[]
  reminderSettings   ReminderSetting[]
  payees             Payee[]
  bills              Bill[]
  occurrences        Occurrence[]
  payments           Payment[]
  creditCards        CreditCard[]
  prefs              HouseholdPrefs?
  pluginStates       PluginState[]
  reminderDeliveries ReminderDelivery[]
}

model Property {
  id               String            @id @default(cuid())
  householdId      String
  household        Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Stable seed key. Renames do not change it.
  slug             String
  name             String
  address          String?
  notes            String?
  kind             PropertyKind      @default(other)
  status           PropertyStatus    @default(active)
  purchaseDate     DateTime?         @db.Date
  /// When this home's role changes. Little Elm becomes a rental on this date.
  roleStartsOn     DateTime?         @db.Date
  roleBecomes      PropertyKind?
  sortOrder        Int               @default(0)
  archivedAt       DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  expenses         Expense[]
  occupancyPeriods OccupancyPeriod[]
  bills            Bill[]
  occurrences      Occurrence[]
  payments         Payment[]
  creditCards      CreditCard[]

  @@unique([householdId, slug])
  @@unique([householdId, name])
  @@index([householdId, sortOrder])
}

model Category {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  slug        String
  name        String
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]
  payees      Payee[]
  bills       Bill[]

  @@unique([householdId, slug])
  @@unique([householdId, name])
  @@index([householdId, sortOrder])
}

/// Nickname plus optional last 4. Never a full account number.
model PaymentMethod {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  slug        String
  nickname    String
  last4       String?
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  expenses    Expense[]
  bills       Bill[]
  payments    Payment[]

  @@unique([householdId, slug])
  @@index([householdId, sortOrder])
}

model Expense {
  id              String        @id @default(cuid())
  householdId     String
  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  /// Calendar date in America/Chicago. No time component.
  expenseDate     DateTime      @db.Date
  propertyId      String
  property        Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  categoryId      String
  category        Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  paymentMethodId String
  paymentMethod   PaymentMethod @relation(fields: [paymentMethodId], references: [id], onDelete: Restrict)
  payee           String
  amount          Decimal       @db.Decimal(12, 2)
  notes           String?
  /// Seeded demo rows. Cleared without touching real expenses.
  isSample        Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([householdId, expenseDate])
  @@index([propertyId, expenseDate])
  @@index([categoryId])
  @@index([paymentMethodId])
  @@index([isSample])
}

/// Later screen: family members as names on the ledger (splits, occupancy).
/// Not logins. No API in v1.
model Person {
  id          String            @id @default(cuid())
  householdId String
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  sortOrder   Int               @default(0)
  archivedAt  DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  splitShares PayerSplitShare[]

  @@unique([householdId, name])
  @@index([householdId, sortOrder])
}

/// Later screen: vehicles. No API in v1.
model Vehicle {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String
  notes       String?
  sortOrder   Int       @default(0)
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([householdId, name])
  @@index([householdId, sortOrder])
}

/// Later screen: effective-dated occupancy. No API in v1.
model OccupancyPeriod {
  id          String       @id @default(cuid())
  householdId String
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  propertyId  String
  property    Property     @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  use         OccupancyUse
  startDate   DateTime     @db.Date
  endDate     DateTime?    @db.Date
  notes       String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([householdId])
  @@index([propertyId, startDate])
}

/// Later screen: how a bill is split across people. No API in v1.
model PayerSplit {
  id          String            @id @default(cuid())
  householdId String
  household   Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name        String?
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  shares      PayerSplitShare[]

  @@index([householdId])
}

model PayerSplitShare {
  id       String     @id @default(cuid())
  splitId  String
  split    PayerSplit @relation(fields: [splitId], references: [id], onDelete: Cascade)
  personId String
  person   Person     @relation(fields: [personId], references: [id], onDelete: Restrict)
  /// 10000 basis points = 100%.
  shareBps Int
  notes    String?

  @@unique([splitId, personId])
}

/// Later screen: reminder lead times. No API in v1.
model ReminderSetting {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  label       String
  enabled     Boolean   @default(true)
  leadDays    Int[]     @default([])
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([householdId])
}

/// Biller. accountLast4 is four digits or empty. Never a full account number.
model Payee {
  id           String    @id @default(cuid())
  householdId  String
  household    Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name         String
  categoryId   String?
  category     Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  accountLast4 String?
  website      String?
  phone        String?
  notes        String?
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  bills        Bill[]
  payments     Payment[]

  @@index([householdId, name])
}

model Bill {
  id               String        @id @default(cuid())
  householdId      String
  household        Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  name             String
  payeeId          String
  payee            Payee         @relation(fields: [payeeId], references: [id], onDelete: Restrict)
  propertyId       String
  property         Property      @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  categoryId       String
  category         Category      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  amountKind       AmountKind    @default(fixed)
  amount           Decimal       @db.Decimal(12, 2)
  anchorDate       DateTime      @db.Date
  autopay          Boolean       @default(false)
  paymentMethodId  String?
  paymentMethod    PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  notes            String?
  portalUrl        String?
  frequency        BillFrequency @default(monthly)
  intervalN        Int           @default(1)
  intervalUnit     IntervalUnit  @default(months)
  /// 1–31, or -1 for the last day of the month. Null keeps the anchor's day.
  dayOfMonth       Int?
  endDate          DateTime?     @db.Date
  endCount         Int?
  shiftWeekends    WeekendShift  @default(none)
  reminderDays     Int[]         @default([])
  graceDays        Int           @default(0)
  generatedThrough DateTime?     @db.Date
  archivedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  occurrences      Occurrence[]
  payments         Payment[]
  creditCard       CreditCard?

  @@index([householdId, archivedAt])
  @@index([propertyId])
  @@index([payeeId])
  @@index([categoryId])
}

model Occurrence {
  id              String    @id @default(cuid())
  householdId     String
  household       Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  billId          String
  bill            Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  propertyId      String
  property        Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  cycleIndex      Int
  dueDate         DateTime  @db.Date
  originalDueDate DateTime? @db.Date
  expectedAmount  Decimal   @db.Decimal(12, 2)
  skippedAt       DateTime?
  snoozedUntil    DateTime? @db.Date
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  payments        Payment[]
  reminders       ReminderDelivery[]

  @@unique([billId, cycleIndex])
  @@index([householdId, dueDate])
  @@index([propertyId, dueDate])
}

model Payment {
  id                   String         @id @default(cuid())
  householdId          String
  household            Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  occurrenceId         String
  occurrence           Occurrence     @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  billId               String
  bill                 Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  propertyId           String
  property             Property       @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  payeeId              String
  payee                Payee          @relation(fields: [payeeId], references: [id], onDelete: Restrict)
  paidOn               DateTime       @db.Date
  amount               Decimal        @db.Decimal(12, 2)
  paymentMethodId      String?
  paymentMethod        PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  confirmationNumber   String?
  note                 String?
  undoneAt             DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([householdId, paidOn])
  @@index([billId])
  @@index([payeeId])
  @@index([propertyId])
  @@index([occurrenceId])
}

/// Last 4 only. The monthly due date is a Bill so paying it matches any other bill.
model CreditCard {
  id               String    @id @default(cuid())
  householdId      String
  household        Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  propertyId       String
  property         Property  @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  billId           String?   @unique
  bill             Bill?     @relation(fields: [billId], references: [id], onDelete: SetNull)
  issuer           String
  nickname         String
  last4            String
  creditLimit      Decimal   @db.Decimal(12, 2)
  currentBalance   Decimal   @db.Decimal(12, 2)
  statementDay     Int
  dueDay           Int
  minimumPayment   Decimal   @db.Decimal(12, 2)
  apr              Decimal?  @db.Decimal(6, 3)
  autopay          Boolean   @default(false)
  archivedAt       DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([householdId])
  @@index([propertyId])
}

model HouseholdPrefs {
  householdId   String         @id
  household     Household      @relation(fields: [householdId], references: [id], onDelete: Cascade)
  reminderDays  Int[]          @default([3, 1, 0])
  digestHour    Int            @default(8)
  digestMinute  Int            @default(0)
  dueSoonDays   Int            @default(7)
  backupDir     String?
  autoBackup    Boolean        @default(true)
  retention     Int            @default(14)
  shiftWeekends WeekendShift   @default(none)
  lastBackupOn  DateTime?      @db.Date
}

model PluginState {
  id          String    @id @default(cuid())
  householdId String
  household   Household @relation(fields: [householdId], references: [id], onDelete: Cascade)
  pluginId    String
  enabled     Boolean   @default(true)

  @@unique([householdId, pluginId])
}

model ReminderDelivery {
  id           String      @id @default(cuid())
  householdId  String
  household    Household   @relation(fields: [householdId], references: [id], onDelete: Cascade)
  dedupeKey    String      @unique
  occurrenceId String?
  occurrence   Occurrence? @relation(fields: [occurrenceId], references: [id], onDelete: Cascade)
  billId       String?
  kind         String
  offsetDays   Int         @default(0)
  channel      String
  sentAt       DateTime    @default(now())

  @@index([householdId, kind])
}

enum PropertyKind {
  primary
  rental
  vacation
  other
}

enum PropertyStatus {
  active
  upcoming
  archived
}

enum AmountKind {
  fixed
  variable
  estimated
}

enum BillFrequency {
  weekly
  biweekly
  monthly
  quarterly
  semiannual
  annual
  every_n
  once
}

enum IntervalUnit {
  days
  weeks
  months
}

enum WeekendShift {
  none
  earlier
  later
}

enum OccupancyUse {
  primary_residence
  second_home
  rental
  vacant_for_rent
  under_construction
  personal
}
